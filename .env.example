# Copiez ce fichier en ".env" (sans le ".example") et remplissez vos identifiants.
# Ne partagez jamais votre .env ni ne le mettez sur GitHub.

# Clé API générée sur https://resend.com (dashboard > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_TO=ineskhanssaou2019@gmail.com

# Optionnel : expéditeur personnalisé une fois un domaine vérifié sur Resend
# (ex. "Portfolio <contact@votredomaine.com>"). Sinon on utilise l'adresse
# de test onboarding@resend.dev fournie par Resend.
# RESEND_FROM=

PORT=3000
